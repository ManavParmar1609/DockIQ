# Copy to backend/.env for local overrides. Every value is optional in development.
# In production (Koyeb) set these as service environment variables / secrets instead.

# development | test | production
ENVIRONMENT=development

# Default: a SQLite file at backend/dev.db. Production: the Neon connection string as Neon shows it,
# e.g. postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/dockiq?sslmode=require
DATABASE_URL=

# Comma-separated origins allowed to call the API (the Vercel URL in production).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Without it, chat answers from the knowledge base by keyword. Free key: build.nvidia.com
NVIDIA_API_KEY=
