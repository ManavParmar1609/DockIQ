# Copy to backend/.env for local overrides (that file is gitignored). Every value is optional in
# development: leave a line commented out to keep its default. In production (Koyeb) set these as
# service environment variables / secrets instead — never commit a real value.

# development | test | production
# ENVIRONMENT=development

# Default: a SQLite file at backend/dev.db. Production: the Neon *direct* connection string (pooling
# off, no "-pooler" in the host: asyncpg's prepared statements need a direct connection), e.g.
# postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# Comma-separated origins allowed to call the API (the Vercel URL in production).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production only: a long random string that signs sign-in tokens (48+ characters).
# JWT_SECRET=

# Password for the seeded demo accounts. Development defaults to dockiq-demo.
# DEMO_PASSWORD=

# The warehouse system behind the WMS boundary: simulated (default) or none.
# WMS_MODE=simulated

# The assistant's model. Optional: without a key, chat answers from the knowledge base by keyword.
# Free key: build.nvidia.com. Put the real key only in backend/.env or the host's secret store.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
